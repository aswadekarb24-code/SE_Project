# Copy to .env and adjust. docker-compose reads this automatically.

# Local dev default (docker-compose postgres service).
# Point this at a real Supabase connection string in production -- no code
# change required, only this value.
DATABASE_URL=postgresql+psycopg://hms:hms@localhost:5433/hms

# Base URL the desktop app's FastAPISyncProvider talks to (Cycle 4+).
HMS_GATEWAY_URL=http://localhost:8000

# Encrypts the local SQLite DB at rest via SQLCipher (NFR-02). REQUIRED for
# any real deployment -- if unset, desktop/data/db.py falls back to a fixed,
# publicly-known dev key so local dev/tests work with zero setup. Generate a
# real secret for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
HMS_DB_ENCRYPTION_KEY=

# Set to "true" in production once a TLS-terminating reverse proxy (or
# uvicorn --ssl-certfile/--ssl-keyfile) is in front of the gateway (NFR-02).
# Leave unset for local docker-compose dev, which has no TLS cert.
HMS_REQUIRE_TLS=
